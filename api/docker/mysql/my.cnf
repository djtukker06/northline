[mysqld]
# utf8mb4 is real UTF-8, four bytes per character. MySQL's older "utf8" is only
# three bytes and cannot store emoji or some CJK characters.
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci

# The buffer pool caches table data and indexes in memory. It is the single most
# important MySQL setting for read performance.
innodb_buffer_pool_size = 256M

# Log queries that take longer than a second, so slow ones can be found and indexed.
slow_query_log = 1
long_query_time = 1
slow_query_log_file = /var/lib/mysql/slow.log

max_connections = 100
