# Copy this file to .env and adjust as needed:  cp .env.example .env
#
# Environment variables keep configuration out of the code. The same code then runs
# against a local database here and a managed database in production, with only
# these values differing. .env is git-ignored on purpose: it holds secrets, and a
# committed secret has to be treated as compromised even after it is deleted.
#
# .env.example IS committed. It documents which variables exist without revealing
# any real values, so a new developer knows what to fill in.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_NAME=NORTHLINE
APP_ENV=local
# Laravel signs cookies and encrypts data with this key. Generate a real one with
#   make key
# Never reuse a key between environments.
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=Europe/Amsterdam

# ---------------------------------------------------------------------------
# Ports published on your machine. Change these if something else already uses them.
# ---------------------------------------------------------------------------
API_PORT=8080
DB_PORT=3306
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# Database. DB_HOST is the docker-compose service name, not localhost: from inside
# the php container, "localhost" would mean the php container itself.
# ---------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=mysql
DB_DATABASE=northline
DB_USERNAME=northline
DB_PASSWORD=secret
DB_ROOT_PASSWORD=rootsecret

# ---------------------------------------------------------------------------
# Redis, used for the cache and the queue.
# ---------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PASSWORD=null
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis

# How long cached API responses stay fresh, in seconds. Raise it to take load off
# the database, lower it to show fresher numbers. This trade-off is the whole of
# caching strategy.
CACHE_TTL=60

# ---------------------------------------------------------------------------
# API keys. Every request to the API must carry one in the X-API-Key header.
# These are demo values; in production they would be long random strings held in
# a secrets manager, and each consumer would get its own so one can be revoked
# without disturbing the others.
# ---------------------------------------------------------------------------
API_KEY_DASHBOARD=nl_dev_dashboard_2f8c41d9b7e64a05
API_KEY_READONLY=nl_dev_readonly_6b3e07a4c1d84f92

# Requests allowed per minute per key, before the API answers 429 Too Many Requests.
RATE_LIMIT_PER_MINUTE=120

# ---------------------------------------------------------------------------
# CORS. Browsers refuse cross-origin requests unless the server opts in. The
# frontend runs on a different port, which counts as a different origin.
# ---------------------------------------------------------------------------
FRONTEND_ORIGIN=http://localhost:3000

LOG_CHANNEL=stack
LOG_LEVEL=debug
